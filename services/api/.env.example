# NAMAT API — environment variable NAMES only (no secrets).
# Copy to .env and fill values locally. Never commit .env.

NODE_ENV=development
PORT=3302
API_PREFIX=api/v1

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=namat
DATABASE_PASSWORD=
DATABASE_NAME=namat
DATABASE_SSL=false
# Set true only for ephemeral local bootstrap; prefer migrations
TYPEORM_SYNC=false

# Auth / sessions
JWT_SECRET=
JWT_EXPIRES_IN=30d
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_EMAIL=5
OTP_RATE_WINDOW_SECONDS=900

# Admin
ADMIN_API_TOKEN=
ADMIN_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_EMAIL=

# SMTP. Production without these values must not claim a code was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public Google OAuth client IDs. No client secret. Server ID is the ID token audience.
GOOGLE_IOS_CLIENT_ID=588751829801-o1l3gdt9fcquhn4ncq5kgig10c7fb0tq.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=588751829801-hncn7v533cpfbbhj6f6nodi7emk92spf.apps.googleusercontent.com
NAMAT_REQUIRE_APP_ATTEST=false

# AI. When set, the API selects the live image provider. Never send Wallet data.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_IMAGE_MODEL=gpt-image-1

# Moyasar is the customer payment provider (Hosted Invoice). Checkout stays off until the owner enables a ready configuration.
# Hosted Invoice readiness needs: secret key matching mode, webhook secret (≥16 chars), and https PUBLIC_BASE_URL.
# MOYASAR_PUBLISHABLE_KEY is optional for the current Hosted Invoice path (required only for future client-side Form/SDK).
# Do not commit key values. PAYMENT_CONFIG_KEY encrypts owner-replaced credentials and stays outside the database.
# Use a random secret of at least 32 characters (`openssl rand -base64 32`). A 16-character string is rejected.
# Length is a floor, not proof of 256-bit entropy.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
PAYMENT_CONFIG_KEY=
# SPKI PEM for macOS/CI IPA attestations. Unset on Linux means publication stays blocked. Not an owner checkbox.
IPA_VERIFICATION_PUBLIC_KEY=

# NearPay remains only for historical terminal purchases. Do not convert those rows to Moyasar.
NEARPAY_API_KEY=
NEARPAY_BASE_URL=https://sandbox-api.nearpay.io
NEARPAY_MERCHANT_ID=
NEARPAY_TERMINAL_ID=
NEARPAY_WEBHOOK_SECRET=
NEARPAY_CURRENCY=SAR
NEARPAY_AMOUNT_HALALAS=29900

# CORS origins (comma-separated)
CORS_ORIGINS=https://namat.shara.sa,https://admin.namat.shara.sa,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3300,http://127.0.0.1:3301

# Local asset storage
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://127.0.0.1:3302

# Logging
LOG_LEVEL=info

# Telegram companion bot (optional).
# Leave TELEGRAM_BOT_TOKEN empty to disable the integration; the API runs normally.
# Never commit a real token or secret — set them only in deployment secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_WEB_BASE=https://namat.shara.sa
