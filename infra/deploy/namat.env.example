# NAMAT production secrets — NAMES and placeholder guidance only.
# Copy to /opt/namat/secrets/namat.env on the server (chmod 600). Never commit real values.

POSTGRES_USER=namat
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=namat

JWT_SECRET=CHANGE_ME_LONG_RANDOM
ADMIN_API_TOKEN=CHANGE_ME_ADMIN_TOKEN
ADMIN_BOOTSTRAP_EMAIL=admin@shara.sa
# Promotes this email to owner on OTP verify. Do not commit a real owner address.
OWNER_BOOTSTRAP_EMAIL=

# Moyasar customer payments (Hosted Invoice). Leave empty until the owner stores keys. Checkout defaults off.
# MOYASAR_PUBLISHABLE_KEY is optional for Hosted Invoice; secret + webhook secret are required for readiness.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
# Random secret, at least 32 characters: openssl rand -base64 32. A 16-character string is not accepted.
PAYMENT_CONFIG_KEY=
# Optional SPKI PEM. Verifies a macOS/CI attestation bound to the IPA SHA-256. Absence keeps publication blocked.
IPA_VERIFICATION_PUBLIC_KEY=

# NearPay — historical terminal purchases only. Do not convert pending rows to Moyasar.
NEARPAY_API_KEY=
NEARPAY_BASE_URL=https://sandbox-api.nearpay.io
NEARPAY_MERCHANT_ID=
# Merchant dashboard UUID used in the remote-purchase JWT. Not the numeric merchant id.
NEARPAY_MERCHANT_UUID=
# SoftPOS terminal Tid from the NearPay terminals page.
NEARPAY_TERMINAL_ID=
# PEM contents of pos_key.pem, with newlines as \n. Required to initiate a terminal purchase.
NEARPAY_JWT_PRIVATE_KEY=
NEARPAY_WEBHOOK_SECRET=
NEARPAY_CURRENCY=SAR
NEARPAY_AMOUNT_HALALAS=29900

# First-boot bootstrap may use true; production must be false after migrations applied.
TYPEORM_SYNC=false
CORS_ORIGINS=https://namat.shara.sa,https://admin.namat.shara.sa
PUBLIC_BASE_URL=https://namat.shara.sa
NEXT_PUBLIC_API_BASE_URL=https://namat.shara.sa/api/v1
NEXT_PUBLIC_PAYMENT_MODE=sandbox

# OTP email — required for customer/admin OTP login in production.
# When unset, API does not email and never logs the OTP code in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NAMAT <noreply@shara.sa>

# Public Google OAuth client IDs. Do not put a Google client secret here.
# Google login does not use SMTP. Audience verification uses the server client ID.
GOOGLE_IOS_CLIENT_ID=588751829801-o1l3gdt9fcquhn4ncq5kgig10c7fb0tq.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=588751829801-hncn7v533cpfbbhj6f6nodi7emk92spf.apps.googleusercontent.com
# Leave false until official App Attest verification is implemented.
NAMAT_REQUIRE_APP_ATTEST=false

# Optional live AI provider key. Empty → MockAiSkinProvider (no Wallet data accepted).
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_IMAGE_MODEL=gpt-image-1
AI_MONTHLY_GENERATION_LIMIT=20

# Inside compose, Next rewrites use the API service hostname.
API_INTERNAL_URL=http://api:3302

# Self-service iPhone registration. Leave Apple values empty until the App Store Connect key exists.
# Empty Apple credentials keep installation unavailable. Do not collect UDIDs by hand.
ENROLLMENT_DATA_KEY=
ENROLLMENT_TTL_SECONDS=900
INSTALL_STRATEGY=AD_HOC_SELF_SERVICE
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=sa.shara.namat.app
APPLE_BUNDLE_ID_RESOURCE_ID=
APPLE_CERTIFICATE_ID=
APPLE_AD_HOC_DEVICE_LIMIT=100
PROFILE_SIGNING_CERT=
PROFILE_SIGNING_KEY=
SIGNING_CALLBACK_TOKEN=
SIGNED_IPA_MAX_BYTES=209715200
# Required in production. One or more PEM trust anchors. System roots are not used.
ENROLLMENT_CMS_TRUST_BUNDLE_PEM=
# Default false. Set true only to also try the expired 2014 Apple iPhone Device CA.
ENROLLMENT_ALLOW_LEGACY_IPHONE_DEVICE_CA=false
# Default false. Records signer metadata and does not enroll the device.
ENROLLMENT_CMS_DIAGNOSTIC=false
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=sharahsa0-creator/namat
GITHUB_SIGNING_WORKFLOW=ios-customer-sign.yml
GITHUB_DISPATCH_REF=main
NAMAT_STABLE_SOURCE_COMMIT=
NAMAT_STABLE_AIRLIFT_SHA=
NAMAT_STABLE_APP_VERSION=
NAMAT_STABLE_BUILD_NUMBER=

# Offsite backup hook. Empty means the local backup runs and the offsite step is skipped.
# Example: OFFSITE_BACKUP_COMMAND='rclone copy /opt/namat/backups remote:namat-backups'
OFFSITE_BACKUP_COMMAND=
