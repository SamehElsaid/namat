# NAMAT admin dashboard
FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
COPY packages/config/package.json packages/config/
COPY apps/admin/package.json apps/admin/
COPY apps/web/package.json apps/web/
COPY services/api/package.json services/api/
RUN pnpm install --filter @namat/admin... --frozen-lockfile

FROM deps AS build
ARG NEXT_PUBLIC_API_BASE_URL=https://namat.shara.sa/api/v1
ARG API_INTERNAL_URL=http://api:3302
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV API_INTERNAL_URL=$API_INTERNAL_URL
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/admin apps/admin
RUN pnpm --filter @namat/admin build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3301
ENV API_INTERNAL_URL=http://api:3302
RUN apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/apps/admin/.next/standalone ./
COPY --from=build /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build /app/apps/admin/public ./apps/admin/public
USER node
EXPOSE 3301
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD curl -fsS http://127.0.0.1:3301/login || exit 1
CMD ["node", "apps/admin/server.js"]
